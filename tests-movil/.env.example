# Copia este archivo como .env y completa los datos (el .env NO se sube al repo)
BASE_URL=https://arriendofacil-qbko.onrender.com

# Cuenta ARRENDADOR de prueba (CP-MOV-01 a 04, 06, 07, 08)
TEST_EMAIL=correo_de_prueba@arriendofacil.com
TEST_PASSWORD=contraseña_de_prueba

# Cuenta ARRENDATARIO de prueba (CP-MOV-05: subir comprobante)
TEST_TENANT_EMAIL=arrendatario_de_prueba@arriendofacil.com
TEST_TENANT_PASSWORD=contraseña_de_prueba

# true = los casos GUARDAN datos reales (crear contrato, subir comprobante, aprobar pago).
# false (por defecto) = llenan formularios y abren modales, pero cancelan sin guardar.
PERMITIR_ESCRITURA=false
