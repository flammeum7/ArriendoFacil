{
  "name": "arriendofacil-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend de ArriendoFácil (Node.js + Express + Prisma + MySQL)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "test": "dotenv -e .env.test -- jest --config jest.config.js --runInBand",
    "test:unit": "dotenv -e .env.test -- jest --config jest.config.js tests/contracts.unit.test.js tests/payments.validation.test.js",
    "test:integration": "dotenv -e .env.test -- jest --config jest.config.js tests/contracts.integration.test.js tests/payments.integration.test.js --runInBand",
    "test:migrate": "dotenv -e .env.test -- prisma migrate deploy"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.1",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2"
  }
}
